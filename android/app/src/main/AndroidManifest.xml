<manifest xmlns:android="http://schemas.android.com/apk/res/android"
>

    <!-- ───────────────────────────────────────────────
         PERMISSIONS
    ─────────────────────────────────────────────────── -->

    <!-- Internet access — required for Firebase, Dio API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera — required for AR/camera features -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ───────────── MEDIA / STORAGE (the "Photos" permission gate) ─────────────
         The app reads/picks captured images & video from the gallery. Saving to
         the gallery via MediaStore needs no permission on API 29+, so only READ
         access is requested at runtime. See PermissionMapper.kt for the
         API-level → concrete-permission mapping the native channel enforces. -->

    <!-- API 33+ : granular media read (request only the types the app uses). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- API ≤32 : legacy read, superseded by granular media on 33+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- API ≤28 : legacy write. A no-op under scoped storage on 29+, so it is
         gated and never requested at runtime above API 28. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- NOTE: ACTIVITY_RECOGNITION is intentionally NOT declared. The "Motion"
         gate uses raw IMU sensors (accelerometer / gyroscope / rotation-vector),
         which require no Android permission. -->


    <!-- Audio recording — required for video/AR recording features -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service — required for background processing tasks -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Needed to start foreground service on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- API 34+ : the upload runs as a `dataSync` foreground service so it survives
         backgrounding; the type-specific permission is required to start it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- API 33+ : posting the upload notification needs this runtime permission. If
         denied, the foreground service still runs (the system suppresses the
         notification's display) — see UploadForegroundService. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network state — optional but recommended for connectivity checks -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wake lock — keeps screen on during AR/camera sessions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ───────────────────────────────────────────────
         HARDWARE FEATURES
    ─────────────────────────────────────────────────── -->

    <!-- Camera is required for this app to function -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Autofocus — required for AR/scanning accuracy -->
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- ───────────────────────────────────────────────
         APPLICATION
    ─────────────────────────────────────────────────── -->

    <application
        android:label="Recapture"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- App launch intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link support — base setup for go_router -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="recapture"
                    android:host="app" />
            </intent-filter>

        </activity>

        <!-- Background-upload foreground service. `dataSync` FGS type (required on
             API 34+, and matched at startForeground). Not exported — started only
             from within the app via the upload_service MethodChannel. -->
        <service
            android:name=".upload.UploadForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Flutter background isolate bridge — required for Firebase -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- Required for Flutter engine text processing plugin -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>
