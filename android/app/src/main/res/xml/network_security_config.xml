<?xml version="1.0" encoding="utf-8"?>
<!-- Network security policy.

     Default: cleartext HTTP is BLOCKED everywhere (this mirrors the previous
     android:usesCleartextTraffic="false" — all real traffic is HTTPS).

     The single exception is the loopback interface: model_viewer_plus serves
     the 3D model viewer page to its WebView from an in-process HTTP proxy on
     127.0.0.1 (see its README, "AndroidManifest.xml (Android 9+ only)").
     Without this exception the viewer renders a blank webview with
     ERR_CLEARTEXT_NOT_PERMITTED. Nothing leaves the device over this route. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
