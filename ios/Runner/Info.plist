<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ───────────────────────────────────────────
	     PERMISSION USAGE DESCRIPTIONS
	─────────────────────────────────────────────── -->

	<!-- Single-locale app (only Base.lproj; no InfoPlist.strings / lib/l10n).
	     These English strings are authoritative. When localization is added,
	     move each usage description into per-locale ios/Runner/<locale>.lproj/
	     InfoPlist.strings so the dialogs show translated copy.

	     App Store note: every iOS permission the app requests has its usage key
	     below — Camera (4A required), Photos (4A optional), and Microphone (video
	     audio). The "Motion" tier uses raw inertial sensors (CMMotionManager:
	     attitude/gyro/accel), which require NO permission and NO usage string, so
	     NSMotionUsageDescription is intentionally ABSENT — the app never touches
	     CMMotionActivityManager (Motion & Fitness). Strings are kept specific and
	     truthful to the observed behavior — generic/mismatched copy is rejected. -->

	<!-- Camera (required) — photographs the object for 3D capture. -->
	<key>NSCameraUsageDescription</key>
	<string>Recapture uses the camera to photograph your object from multiple angles and build a 3D capture.</string>

	<!-- Microphone — records audio alongside video capture sessions. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Recapture uses the microphone to record audio while you capture video of your object.</string>

	<!-- Photo Library — Screen 4A requests Permission.photos (read access) to
	     import reference images and browse saved captures; the add-only key
	     covers saving finished captures. Without these keys, requesting the
	     permission CRASHES on iOS. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Recapture uses your photo library to import reference images and open captures you have saved.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Recapture saves your finished captures to your photo library.</string>

	<!-- ───────────────────────────────────────────
	     AR CAPABILITY DECLARATION
	─────────────────────────────────────────────── -->

	<!-- Declares AR as a required device capability -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>arkit</string>
	</array>

	<!-- ───────────────────────────────────────────
	     APP TRANSPORT SECURITY
	─────────────────────────────────────────────── -->

	<!-- Block all cleartext HTTP — all traffic must use HTTPS -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ───────────────────────────────────────────
	     DEEP LINK URL SCHEME (go_router)
	─────────────────────────────────────────────── -->

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mayasabhaxr.recapture</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>recapture</string>
			</array>
		</dict>
	</array>

	<!-- ───────────────────────────────────────────
	     BUNDLE / APP IDENTITY
	─────────────────────────────────────────────── -->

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Recapture</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>recapture</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ───────────────────────────────────────────
	     SCENE CONFIGURATION
	─────────────────────────────────────────────── -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ───────────────────────────────────────────
	     DISPLAY + ORIENTATION
	─────────────────────────────────────────────── -->

	<!-- Lock to portrait for camera and AR sessions -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- iPad — allow portrait orientations -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- ───────────────────────────────────────────
	     FLUTTER SPECIFIC
	─────────────────────────────────────────────── -->

	<!-- Enables high frame rate rendering on ProMotion displays -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
</dict>
</plist>
