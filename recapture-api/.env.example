# Server
NODE_ENV=development
PORT=3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recapture?retryWrites=true&w=majority

# JWT
JWT_SECRET=<minimum-32-character-random-string>
JWT_EXPIRES_IN=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# S3 Buckets
S3_BUCKET_RAW=msxr-raw-captures
S3_BUCKET_ARTIFACTS=msxr-model-artifacts

# CloudFront
CLOUDFRONT_BASE_URL=https://<your-cloudfront-domain>.cloudfront.net

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API. Comma-separated, matched EXACTLY
# (scheme + host + port, no path, no trailing slash). The mobile builds send no
# Origin header and are unaffected; localhost/127.0.0.1 on any port is allowed
# automatically outside production (flutter run -d chrome picks a random port).
# Default: https://recapture-live.onrender.com
# CORS_ALLOWED_ORIGINS=https://recapture-live.onrender.com

# ── Auth tunables (all OPTIONAL — safe defaults in src/config/env.ts) ────────
# Uncomment to override. Shown values are the defaults.

# OTP send (send-otp)
# OTP_TTL_SECONDS=300
# RESEND_COOLDOWN_SECONDS=60
# MAX_SENDS_PER_WINDOW=5
# RATE_WINDOW_SECONDS=3600
# OTP_HASH_SECRET=<optional-dedicated-otp-hmac-secret-min-16-chars>   # falls back to JWT_SECRET
# OTP_SIMULATE_DISPATCH_FAILURE=false                                  # dev/test: force the 502 path

# OTP verify + session tokens (verify-otp)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# MAX_OTP_ATTEMPTS=5
# MAX_VERIFY_ATTEMPTS_PER_WINDOW=10
# VERIFY_WINDOW_SECONDS=900
# JWT_SIMULATE_SIGN_FAILURE=false                                      # dev/test: force the 500 path

# Token refresh (refresh)
# MAX_REFRESH_PER_WINDOW=30
# REFRESH_WINDOW_SECONDS=900

# Upload pipeline (POST /jobs)
# UPLOAD_PLAN_TTL_SECONDS=86400

# Staff export (GET /admin/projects/:id/export)
# ADMIN_EXPORT_URL_TTL_SECONDS=3600
# ADMIN_EXPORT_MAX_PER_WINDOW=10
# ADMIN_EXPORT_WINDOW_SECONDS=3600

# Profile pictures (/auth/me/avatar) — stored in S3_BUCKET_RAW (private: an
# avatar is PII), never behind CloudFront.
# AVATAR_MAX_BYTES=2097152                      # 2 MiB — enforced at COMMIT (presigns can't cap size)
# AVATAR_UPLOAD_URL_TTL_SECONDS=900             # presigned PUT slot
# AVATAR_GET_URL_TTL_SECONDS=3600               # presigned GET on the account snapshot
# AVATAR_UPLOAD_MAX_PER_WINDOW=10
# AVATAR_UPLOAD_WINDOW_SECONDS=3600

# ── Background worker (all OPTIONAL — safe defaults in src/config/env.ts) ────
# Separate process: `npm run worker` (dev: `npm run worker:dev`).
#
# ...OR run the loop inside the API process, for a single-service deployment
# (one instance, one bill). `npm run dev` then processes jobs on its own — no
# second terminal, no second Render service. Safe only while every processor is
# I/O-bound; see the flag's note in src/config/env.ts before leaving it on.
# RUN_WORKER_IN_PROCESS=false
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_CLAIM_TIMEOUT_MS=120000
# WORKER_CONCURRENCY=2
# WORKER_HEARTBEAT_EVERY_N_POLLS=20

# ── Meshy AI model generation (docs/meshy-integration-implementation-prompt.md) ─
# Staff-triggered "Create Model" from 3-4 Preview-gallery photos. Only the process
# RUNNING THE WORKER LOOP calls Meshy — the dedicated worker, or the API itself
# under RUN_WORKER_IN_PROCESS. MESHY_API_KEY is required there (it fails fast at
# boot without it) and unused by an API that only enqueues.
# MESHY_API_KEY=<secret-meshy-api-key>          # SECRET — never commit, never log
# MESHY_BASE_URL=https://api.meshy.ai
# MESHY_POLL_INTERVAL_MS=5000                   # keep << WORKER_CLAIM_TIMEOUT_MS
# MESHY_TASK_TIMEOUT_MS=600000
# MESHY_SOURCE_URL_TTL_SECONDS=3600
# MESHY_TARGET_POLYCOUNT=100000                 # 100–300000; the phone's budget
# MESHY_TEXTURE_RESOLUTION=2k                   # 2k | 4k | 8k
# MESHY_CREATE_MAX_PER_WINDOW=20                # each generation costs credits
# MESHY_CREATE_WINDOW_SECONDS=3600
# MODEL_IMAGE_UPLOAD_URL_TTL_SECONDS=900        # presigned PUTs for edited model inputs
# MODEL_IMAGE_UPLOAD_MAX_PER_WINDOW=60          # presigns only — credits guarded on Create-Model
# MODEL_IMAGE_UPLOAD_WINDOW_SECONDS=3600

# ── Model optimization ("Optimize" action → an OPT variant in the model list) ──
# Runs a SUCCEEDED model's GLB through glTF-Transform (dedup/prune/weld/texture
# recompression/meshopt) and writes the result back as its own record. Costs CPU,
# never Meshy credits.
# MODEL_OPTIMIZE_THRESHOLD_BYTES=5242880        # 5 MiB — BINARY; the client formats sizes with the same 1024 divisor
# MODEL_OPTIMIZE_MAX_INPUT_BYTES=262144000      # 250 MiB — glTF-Transform is in-memory; above this it OOMs the worker
# MODEL_OPTIMIZE_MAX_PER_WINDOW=20              # owner route only — CPU-expensive, so still bounded
# MODEL_OPTIMIZE_WINDOW_SECONDS=3600

# ── Automatic model generation (after a capture finishes, no human in the loop)
# OFF by default: this spends Meshy credits on every finished capture. Turn it
# on deliberately, per environment. The live kill switch is the
# `autoModelGenerationEnabled` field on the client_configs document — set that
# to false to stop generation instantly without a deploy.
# AUTO_MODEL_GENERATION_ENABLED=false
# AUTO_MODEL_MAX_PER_USER_PER_DAY=10            # per-owner rolling 24h ceiling
# AUTO_MODEL_MIN_BLUR_SCORE=40                  # matches the client REJECT floor

# ── On-demand model generation (the "Generate 3D model" button)
# Same server-side photo selection, triggered by a person instead of by a
# capture finishing. A SEPARATE flag from AUTO_MODEL_GENERATION_ENABLED on
# purpose: this is how the selector gets exercised on real captures — one
# deliberate press at a time — before unattended per-capture spend is enabled.
# Live kill switch: the `manualModelGenerationEnabled` field on the
# client_configs document.
# MANUAL_MODEL_GENERATION_ENABLED=false
# MANUAL_MODEL_MAX_PER_USER_PER_DAY=5           # shares the automatic 24h ceiling
# MANUAL_MODEL_MAX_PER_STAFF_PER_DAY=25         # staff ceiling — higher, not exempt











# ── Mirage catalog publishing (docs/next-phase/03-architecture-proposal.md) ────
# Publishing a catalog into Mirage, the customer-facing hosting system. ONLY the
# process running the worker loop (and the analytics proxy) talks to Mirage, so
# every variable here is optional at boot — an API that neither publishes nor
# reads analytics must not fail to start over a credential it never uses.
# Presence is enforced at the call site instead (assertMirageConfigured()).
#
# NEVER expose any of these to the Flutter client. The credential below is
# UNSCOPED: it grants read/write over every business in Mirage.
# MIRAGE_BASE_URL=https://<mirage-host>         # origin only — the adapter appends /api/v1
# MIRAGE_API_KEY=<secret-mirage-api-key>        # SECRET — Mirage's static `apikey` header
#
# Admin credential for Mirage's `token` header. PREFER MIRAGE_ADMIN_TOKEN:
# Mirage signs login tokens with JWT_SECRET but verifies them with
# JWT_SECRET_KEY (two different variable names), so a token we mint by logging
# in may not verify in a deployment that sets only one of them.
# MIRAGE_ADMIN_TOKEN=<secret-admin-jwt>         # SECRET — preferred
# MIRAGE_ADMIN_USER_ID=<24-hex-mongo-objectid>  # fallback: `id` for POST /login-user (NOT an email)
# MIRAGE_ADMIN_PASSWORD=<secret>                # SECRET — fallback, used with the id above
# MIRAGE_ADMIN_TOKEN_TTL_SECONDS=43200          # re-mint well inside Mirage's own 1d JWT_EXPIRE
#
# MIRAGE_PUBLIC_BASE_URL=https://<mirage-site>  # the host a QR encodes: {this}/{mirageRestaurantId}
#
# Where Mirage writes ITS copy of our assets. Mirage reads both FROM THE REQUEST
# BODY on every write and bakes the CDN host into the URL it stores — omit them
# and it persists a customer-facing URL starting with the string "undefined".
# MIRAGE_ASSET_BUCKET=maya-restaurants
# MIRAGE_ASSET_CDN_URL=https://d1ubv1fp33ooxl.cloudfront.net
#
# MIRAGE_REQUEST_TIMEOUT_MS=60000               # a write is a whole-model multipart upload
# MIRAGE_MAX_ASSET_BYTES=94371840               # 90 MiB — under Mirage's 100 MB multer cap
# How assets reach Mirage: `bytes` streams them through this process (works
# against Mirage as deployed); `url` sends our CloudFront URL for Mirage to
# fetch and REQUIRES Mirage prompt M1 — switch it on early and products publish
# with no image and no model.
# MIRAGE_ASSET_TRANSFER_MODE=bytes
#
# Publish rate limits (DB-backed sliding windows; there is no Redis).
# PUBLISH_MAX_PER_WINDOW=10                     # publish runs per user per window
# PUBLISH_RETRY_MAX_PER_WINDOW=20               # tighter: Retry is one tap beside a failure list
# PUBLISH_WINDOW_SECONDS=3600
#
# QR rendering (server-side, from the STORED public URL — never recomputed).
# CATALOG_QR_MAX_PER_WINDOW=60
# CATALOG_QR_WINDOW_SECONDS=600
#
# Publish runs kept per catalog for the activity log. A COUNT, not a TTL, and
# pruned on write — expiring on age would empty the history of a business that
# publishes twice a year.
# CATALOG_ACTIVITY_RETAINED_RUNS=50
# CATALOG_PRODUCT_IMAGE_MAX_BYTES=5242880       # 5 MiB — enforced at COMMIT, not presign
# PRODUCT_IMAGE_UPLOAD_URL_TTL_SECONDS=900
# PRODUCT_IMAGE_UPLOAD_MAX_PER_WINDOW=120       # a catalog setup is dozens of photos
# PRODUCT_IMAGE_UPLOAD_WINDOW_SECONDS=3600
# CATALOG_PRODUCT_IMAGE_MAX_BYTES=5242880       # 5 MiB — enforced at COMMIT, not at presign
# PRODUCT_IMAGE_UPLOAD_URL_TTL_SECONDS=900      # presigned PUT slot for a product image
